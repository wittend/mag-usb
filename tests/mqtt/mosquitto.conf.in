# Local test broker for mag-usb.  Generated by setup_broker.sh; do not edit the copy in run/.
# Not for production.

# Required: with per_listener_settings true, the dynsec plugin refused every
# login on the listeners below, even with a valid password.
per_listener_settings false
persistence false
log_dest stderr
log_type error
log_type warning
log_type notice

allow_anonymous false

listener @PORT_PLAIN@ 127.0.0.1

listener @PORT_TLS@ 127.0.0.1
cafile @RUN_DIR@/certs/ca.crt
certfile @RUN_DIR@/certs/server.crt
keyfile @RUN_DIR@/certs/server.key
tls_version tlsv1.2

listener @PORT_WS@ 127.0.0.1
protocol websockets

plugin @DYNSEC_PLUGIN@
plugin_opt_config_file @RUN_DIR@/dynamic-security.json
